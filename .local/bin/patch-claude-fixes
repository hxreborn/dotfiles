#!/usr/bin/env python3
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

PATCHES = [
    (".patch-claude-kpt-original.bin", 'return e??""'),
    (".patch-claude-cs-original.bin", "return!0"),
]

SIGNATURE_RE = re.compile(r"^function \w+\([^)]*\)\{")


def find_binary():
    bin_path = os.path.expanduser(
        "~/.npm-global/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe"
    )
    return bin_path if os.path.isfile(bin_path) else None


def main():
    bin_path = find_binary()
    if not bin_path:
        return 0

    data = open(bin_path, "rb").read()
    text = data.decode("latin1")
    applied = []

    for original_file, return_body in PATCHES:
        original = open(os.path.join(HERE, original_file), "rb").read().decode("latin1")

        m = SIGNATURE_RE.match(original)
        if not m:
            continue  # reference file itself doesn't look like a function anymore
        head = m.group(0) + return_body
        tail = "}"
        pad_len = len(original) - len(head) - len(tail)
        if pad_len < 0:
            continue
        replacement = head + (" " * pad_len) + tail

        if text.count(original) != 1:
            continue  # already patched, or upstream changed shape: leave it alone

        text = text.replace(original, replacement, 1)
        applied.append(original_file)

    if not applied:
        print("claude: 0 of {} known fixes applied (binary shape changed?)".format(len(PATCHES)), file=sys.stderr)
        return 0

    patched = text.encode("latin1")
    if len(patched) != len(data):
        return 0  # length mismatch somewhere: refuse rather than corrupt

    tmp = bin_path + ".claudefixes"
    with open(tmp, "wb") as f:
        f.write(patched)
    os.chmod(tmp, os.stat(bin_path).st_mode)
    os.replace(tmp, bin_path)
    print(f"claude: applied fixes: {', '.join(applied)}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
