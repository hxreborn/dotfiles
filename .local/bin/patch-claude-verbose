#!/bin/bash
# Patch Claude Code to always show expanded tool calls
# Version-agnostic: uses regex to find collapsed_read_search verbose:VAR and replaces with verbose:!0

CLI_JS=$(node -e "try{const p=require('path'),r=require('child_process').execSync('npm root -g',{encoding:'utf8'}).trim();console.log(p.join(r,'@anthropic-ai/claude-code/cli.js'))}catch{}" 2>/dev/null)

if [ ! -f "$CLI_JS" ]; then
  echo "Could not find Claude Code cli.js"
  exit 1
fi

if grep -qP 'case"collapsed_read_search":return \w+\.createElement\(\w+,\{[^}]*verbose:!0' "$CLI_JS"; then
  echo "Already patched."
  exit 0
fi

# Backup
cp -n "$CLI_JS" "$CLI_JS.bak"

# Replace verbose:<any_var> with verbose:!0 in collapsed_read_search case
sed -i -E 's/(case"collapsed_read_search":return [A-Za-z0-9]+\.createElement\([A-Za-z0-9]+,\{[^}]*verbose:)[A-Za-z0-9]+/\1!0/' "$CLI_JS"

if grep -qP 'case"collapsed_read_search":return \w+\.createElement\(\w+,\{[^}]*verbose:!0' "$CLI_JS"; then
  echo "Patched successfully."
else
  echo "Patch failed — pattern may have changed."
  cp "$CLI_JS.bak" "$CLI_JS"
  exit 1
fi
