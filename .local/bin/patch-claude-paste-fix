#!/usr/bin/env python3
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ORIGINAL_FILE = os.path.join(HERE, ".patch-claude-kpt-original.bin")
REPLACEMENT_HEAD = 'function Kpt(e,n,o){return e??""'
REPLACEMENT_TAIL = "}"


def find_binary():
    bin_path = os.path.expanduser(
        "~/.npm-global/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe"
    )
    return bin_path if os.path.isfile(bin_path) else None


def main():
    bin_path = find_binary()
    if not bin_path:
        return 0

    original = open(ORIGINAL_FILE, "rb").read().decode("latin1")
    pad_len = len(original) - len(REPLACEMENT_HEAD) - len(REPLACEMENT_TAIL)
    if pad_len < 0:
        return 0
    replacement = REPLACEMENT_HEAD + (" " * pad_len) + REPLACEMENT_TAIL

    data = open(bin_path, "rb").read()
    text = data.decode("latin1")

    if text.count(original) != 1:
        return 0  # already patched, or upstream changed shape: leave it alone

    patched = text.replace(original, replacement, 1)
    if len(patched) != len(text):
        return 0

    tmp = bin_path + ".pastefix"
    with open(tmp, "wb") as f:
        f.write(patched.encode("latin1"))
    os.chmod(tmp, os.stat(bin_path).st_mode)
    os.replace(tmp, bin_path)
    print("claude: paste-content tagging disabled", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
