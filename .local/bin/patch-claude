#!/bin/sh
# patch-claude -- keep Claude Code on a-connoisseur's latest *patched* build.
#
# Source of truth: https://github.com/a-connoisseur/patch-claude-code releases.
# On launch (called from the fish/zsh `claude` wrapper) it checks the latest
# patched linux release; if the installed binary isn't it, it downloads the
# new one WITH a progress bar and atomically swaps it in. Silent no-op when
# already current. GitHub is polled at most once/hour, and every failure is
# non-fatal: if anything goes wrong we just launch whatever is installed.
#
# Usage: patch-claude [--force|--demo]
#   --force  ignores the hourly throttle
#   --demo   renders the progress bar against a fake download and exits

REPO="a-connoisseur/patch-claude-code"
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)  PLAT="linux-x64" ;;
    Linux-aarch64) PLAT="linux-arm64" ;;
    *)             PLAT="linux-x64" ;;   # ponytail: only linux handled; add cases if needed
esac

if [ -t 2 ]; then
    Y=$(printf '\033[1;33m'); D=$(printf '\033[2m'); N=$(printf '\033[0m')
    CLR=$(printf '\033[K')
else
    Y=''; D=''; N=''; CLR=''
fi

finish() { "$HOME/.local/bin/patch-claude-paste-fix"; exit 0; }

mb() { printf '%d.%d' $(($1 / 1048576)) $(($1 * 10 / 1048576 % 10)); }

# pacman ILoveCandy bar. globals: total width start frame
draw() {
    got=$1
    [ "$got" -gt "$total" ] && got=$total
    pct=$((got * 100 / total))
    fill=$((pct * width / 100))
    [ "$fill" -ge "$width" ] && fill=$((width - 1))
    ms=$(($(date +%s%3N) - start)); [ "$ms" -lt 1 ] && ms=1
    kbs=$((got * 1000 / ms / 1024))
    if [ "$kbs" -le 0 ]; then
        eta='--'
    else
        s=$(((total - got) / kbs / 1024))
        if [ "$s" -ge 60 ]; then eta=$(printf '%dm%02ds' $((s / 60)) $((s % 60))); else eta="${s}s"; fi
    fi
    if [ $((frame % 2)) -eq 0 ]; then pac='C'; else pac='c'; fi
    printf '\r  [%s%s%s%s%s%s]%4d%%  %sM/%sM  %d.%d MB/s  eta %s%s' \
        "$(printf '%*s' "$fill" '' | tr ' ' '-')" \
        "$Y" "$pac" "$N" \
        "$D$(printf '%*s' $((width - fill - 1)) '' | tr ' ' 'o')" "$N" \
        "$pct" "$(mb "$got")" "$(mb "$total")" \
        $((kbs / 1024)) $((kbs * 10 / 1024 % 10)) "$eta" "$CLR" >&2
}

bar_width() {
    cols=$(tput cols 2>/dev/null || echo 80)
    width=$((cols - 48))
    [ "$width" -gt 42 ] && width=42
    [ "$width" -lt 12 ] && width=12
}

if [ "$1" = "--demo" ]; then
    total=$((205 * 1048576)); frame=0; got=0
    bar_width
    start=$(date +%s%3N)
    while [ "$got" -lt "$total" ]; do
        draw "$got"
        got=$((got + total / 55)); frame=$((frame + 1))
        sleep 0.08
    done
    draw "$total"; printf '\n' >&2
    exit 0
fi

cache="${XDG_CACHE_HOME:-$HOME/.cache}"
installed="$cache/patch-claude.installed"   # "<version> <mtime>" of the build we put in place
lastcheck="$cache/patch-claude.lastcheck"   # epoch of last GitHub poll
mkdir -p "$cache" 2>/dev/null

force=0
[ "$1" = "--force" ] && force=1

# locate the native binary
bin="$HOME/.npm-global/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe"
if [ ! -f "$bin" ]; then
    cc=$(command -v claude 2>/dev/null)
    [ -n "$cc" ] && bin=$(readlink -f "$cc" 2>/dev/null)
fi
[ -f "$bin" ] || finish

cur_mtime=$(stat -c %Y "$bin" 2>/dev/null || echo 0)
inst_ver=""; inst_mtime=""
[ -f "$installed" ] && read -r inst_ver inst_mtime < "$installed"

# our patched build still sitting where we left it?
in_place=0
[ -n "$inst_ver" ] && [ "$inst_mtime" = "$cur_mtime" ] && in_place=1

# throttle: if patched build is in place and we polled < 1h ago, do nothing
now=$(date +%s 2>/dev/null || echo 0)
last=$(cat "$lastcheck" 2>/dev/null || echo 0)
if [ "$force" -eq 0 ] && [ "$in_place" -eq 1 ] && [ $((now - last)) -lt 3600 ]; then
    finish
fi

# latest patched version for this platform (source of truth = the repo)
latest=$(curl -fsSL --max-time 8 "https://api.github.com/repos/$REPO/releases?per_page=100" 2>/dev/null \
    | grep -oE "\"v[0-9]+\.[0-9]+\.[0-9]+-$PLAT\"" \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -1)
echo "$now" > "$lastcheck" 2>/dev/null
[ -n "$latest" ] || finish                       # API/network down -> launch current

# already on the latest patched build?
[ "$in_place" -eq 1 ] && [ "$inst_ver" = "$latest" ] && finish

url="https://github.com/$REPO/releases/download/v${latest}-$PLAT/claude.native.patched"
printf 'claude: fetching patched build v%s\n' "$latest" >&2

dir=$(dirname "$bin")
tmp=$(mktemp "$dir/.claude.patched.XXXXXX") || finish

total=$(curl -fsIL --max-time 8 "$url" 2>/dev/null | tr -d '\r' \
    | awk 'tolower($1) == "content-length:" { n = $2 } END { print n + 0 }')

if [ "$total" -gt 0 ] && [ -t 2 ]; then
    bar_width
    frame=0
    start=$(date +%s%3N)
    trap 'printf "\033[?25h" >&2' EXIT INT TERM
    printf '\033[?25l' >&2
    curl -fsSL -o "$tmp" "$url" &
    cpid=$!
    while kill -0 "$cpid" 2>/dev/null; do
        draw "$(stat -c %s "$tmp" 2>/dev/null || echo 0)"
        frame=$((frame + 1))
        sleep 0.12
    done
    wait "$cpid"; rc=$?
    [ "$rc" -eq 0 ] && draw "$total"
    printf '\033[?25h\n' >&2
else
    # -fSL (no -s) so curl's --progress-bar is shown
    curl -fSL --progress-bar -o "$tmp" "$url"; rc=$?
fi

if [ "$rc" -ne 0 ]; then
    rm -f "$tmp"; echo 'claude: download failed, launching current build' >&2; finish
fi

# sanity check: ELF + carries the patched header, or we don't touch anything
magic=$(head -c 4 "$tmp" | od -An -tx1 2>/dev/null | tr -d ' \n')
if [ "$magic" != "7f454c46" ] || ! grep -qa '(patched)' "$tmp"; then
    rm -f "$tmp"; echo 'claude: downloaded file failed verification, launching current build' >&2; finish
fi

chmod --reference="$bin" "$tmp" 2>/dev/null || chmod 755 "$tmp"
if mv -f "$tmp" "$bin"; then                      # same fs -> atomic rename
    printf '%s %s\n' "$latest" "$(stat -c %Y "$bin" 2>/dev/null)" > "$installed"
    printf 'claude: patched build v%s installed\n' "$latest" >&2
else
    rm -f "$tmp"; echo 'claude: install failed, launching current build' >&2
fi
finish
