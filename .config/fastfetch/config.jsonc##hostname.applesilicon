{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "\"$(fastfetch.sh logo)\"",
    "height": 18
  },
  "display": {
    "separator": " : ",
    "color": "90",
    "size": {
      "binaryPrefix": "SI"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "   OS",
      "format": "{name} {version} {arch}",
      "keyColor": "38;2;243;139;168"
    },
    {
      "type": "kernel",
      "key": "  󰒓 Kernel",
      "format": "{1} {2}",
      "keyColor": "38;2;242;205;205"
    },
    {
      "type": "shell",
      "key": "  󰆍 Shell",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{width}x{height} @ {refresh-rate} Hz ({inch}\")",
      "keyColor": "38;2;148;226;213"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "38;2;249;226;175"
    },
    {
      "type": "battery",
      "key": "  󰁹 Battery",
      "format": "{capacity} ({time-formatted} remaining)",
      "keyColor": "38;2;250;179;135"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": "  ",
      "keyColor": "38;2;203;166;247",
      "format": "{6} {7} {8}"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "  󰘚 CPU",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "gpu",
      "key": "  󰊴 GPU",
      "keyColor": "38;2;116;199;236"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "command",
      "key": "  󰋊 macOS (/)",
      "keyColor": "38;2;203;166;247",
      "text": "~/.config/fastfetch/disk.sh macos"
    },
    {
      "type": "command",
      "key": "  󰋊 Asahi",
      "keyColor": "38;2;203;166;247",
      "text": "~/.config/fastfetch/disk.sh asahi"
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age",
      "keyColor": "38;2;235;160;172",
      "text": "bash -c 'BIRTH=$(stat -f %B /var/db/.AppleSetupDone 2>/dev/null || stat -f %B /); DAYS=$(( ($(date +%s) - BIRTH) / 86400 )); DATE=$(date -r $BIRTH \"+%b %d, %Y\"); echo \"$DAYS days ($DATE)\"'"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
      "block": {
        "range": [0, 7]
      }
    },
    "break"
  ]
}
