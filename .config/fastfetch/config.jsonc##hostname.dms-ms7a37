{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "\"$(fastfetch.sh logo)\"",
    "height": 20
  },
  "display": {
    "separator": " : ",
    "color": "90"
  },
  "modules": [
    {
      "type": "command",
      "key": "  󰍩",
      "keyColor": "38;2;163;201;255",
      "text": "splash=$(hyprctl splash);echo $splash"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "   Distro",
      "format": "{name} {arch}",
      "keyColor": "38;2;163;201;255"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "38;2;163;201;255"
    },
    {
      "type": "bootmgr",
      "key": "  󰒓 Bootmgr",
      "format": "{1}",
      "keyColor": "38;2;188;199;219"
    },
    {
      "type": "command",
      "key": "  󰉁 Init",
      "keyColor": "38;2;188;199;219",
      "text": "cat /proc/1/comm"
    },
    {
      "type": "shell",
      "key": "  󰈺 Shell",
      "keyColor": "38;2;217;189;227"
    },
    {
      "type": "terminal",
      "key": "  󰆍 Term",
      "keyColor": "38;2;217;189;227"
    },
    {
      "type": "wm",
      "key": "  󰖯 WM",
      "format": "{pretty-name} {version} ({protocol-name})",
      "keyColor": "38;2;163;201;255"
    },
    {
      "type": "lm",
      "key": "  󰍂 LM",
      "keyColor": "38;2;188;199;219"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": "  ",
      "keyColor": "38;2;227;226;230",
      "format": "{6} {7} {8}"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "  󰘚 CPU",
      "format": "{name} @ {freq-max}",
      "keyColor": "38;2;163;201;255"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "38;2;163;201;255"
    },
    {
      "type": "display",
      "key": "  󰍹 Monitor",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "38;2;188;199;219"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "38;2;217;189;227"
    },
    {
      "type": "command",
      "key": "  󰋊 Root",
      "keyColor": "38;2;255;180;171",
      "text": "df -hT / | awk 'NR==2{printf \"%s / %s (%s) - %s\", $4, $3, $6, $2}'"
    },
    {
      "type": "packages",
      "key": "  󰏖 Pkgs",
      "keyColor": "38;2;217;189;227"
    },
    {
      "type": "command",
      "key": "  󰃩 OS Age",
      "keyColor": "38;2;195;198;207",
      "text": "bash -c 'DAYS=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); DATE=$(LC_TIME=C date -d @$(stat -c %W /) \"+%b %d, %Y\"); echo \"$DAYS days ($DATE)\"'"
    },
    {
      "type": "uptime",
      "key": "  󱑂 Uptime",
      "keyColor": "38;2;195;198;207"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
      "block": {
        "range": [
          0,
          7
        ]
      }
    },
    "break"
  ]
}