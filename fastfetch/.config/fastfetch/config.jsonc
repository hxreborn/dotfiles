{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "\"$(fastfetch.sh logo)\"",
    "height": 20
  },
  "display": {
    "separator": " : ",
    "color": "90"
  },
  "modules": [
    {
      "type": "command",
      "key": "  󰍩",
      "keyColor": "38;2;180;190;254",
      "text": "splash=$(hyprctl splash);echo $splash"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{name} {arch}",
      "keyColor": "38;2;243;139;168"
    },
    {
      "type": "bootmgr",
      "key": "  󰩡 Bootloader",
      "keyColor": "38;2;242;205;205"
    },
    {
      "type": "kernel",
      "key": "  󰌽 Kernel",
      "format": "{2}",
      "keyColor": "38;2;242;205;205"
    },
    {
      "type": "shell",
      "key": "  󰆍 Shell",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "38;2;148;226;213"
    },
    // {
    //   "type": "monitor",
    //   "key": "  󰹑 Monitor",
    //   "format": "{name} ({width}x{height})",
    //   "keyColor": "38;2;148;226;213"
    // },
    {
      "type": "terminal",
      "key": "  󰗊 Terminal",
      "keyColor": "38;2;249;226;175"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{pretty-name} {version} ({protocol-name})",
      "keyColor": "38;2;250;179;135"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": "  ",
      "keyColor": "38;2;203;166;247",
      "format": "{6} {7} {8}"
    },
    {
      "type": "custom",
      "format": "┌──────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "  󰘚 CPU",
      "format": "{name} @ {freq-max}",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "gpu",
      "key": "  󰊴 GPU",
      "keyColor": "38;2;116;199;236"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "physicalmemory",
      "key": "  󰑹 RAM",
      "format": "{type}-{running-speed} MT/s",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "command",
      "key": "  󰋊 Disk (/)",
      "keyColor": "38;2;203;166;247",
      "text": "~/.config/fastfetch/disk.sh"
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age",
      "keyColor": "38;2;235;160;172",
      "text": "bash -c 'DAYS=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); DATE=$(LC_TIME=C date -d @$(stat -c %W /) \"+%b %d, %Y\"); echo \"$DAYS days ($DATE)\"'"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
      "block": {
        "range": [0, 7]
      }
    },
    "break"
  ]
}
