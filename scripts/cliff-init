#!/usr/bin/env bash
set -euo pipefail

# Drop the dotfiles cliff.toml template into a repo as .github/cliff.toml,
# substituting owner/repo from `git remote get-url origin`.
#
# Usage:
#   cliff-init                 # current repo
#   cliff-init <repo-path>     # target repo
#   cliff-init -f              # overwrite existing .github/cliff.toml

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="$SCRIPT_DIR/templates/cliff.toml"

force=0
target="."

while (($#)); do
  case "$1" in
    -f|--force) force=1 ;;
    -h|--help)
      sed -n '4,10p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) target="$1" ;;
  esac
  shift
done

[[ -f "$TEMPLATE" ]] || { echo "template missing: $TEMPLATE" >&2; exit 1; }

cd "$target"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "not a git repo: $target" >&2; exit 1
}

remote_url="$(git remote get-url origin 2>/dev/null || true)"
[[ -n "$remote_url" ]] || { echo "no 'origin' remote configured" >&2; exit 1; }

# Parse owner/repo from common GitHub URL forms:
#   git@github.com:owner/repo.git
#   https://github.com/owner/repo.git
#   https://github.com/owner/repo
if [[ "$remote_url" =~ github\.com[:/]([^/]+)/([^/]+)$ ]]; then
  owner="${BASH_REMATCH[1]}"
  repo="${BASH_REMATCH[2]%.git}"
else
  echo "could not parse GitHub owner/repo from: $remote_url" >&2
  exit 1
fi

dest=".github/cliff.toml"
if [[ -f "$dest" && $force -eq 0 ]]; then
  echo "$dest already exists. Use -f to overwrite." >&2
  exit 1
fi

mkdir -p .github
sed -e "s|__OWNER__|$owner|g" -e "s|__REPO__|$repo|g" "$TEMPLATE" > "$dest"
echo "wrote $dest (owner=$owner, repo=$repo)"
